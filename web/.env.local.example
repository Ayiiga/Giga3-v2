# Copy to web/.env.local for local development / production build tests.
# Convention: NEXT_PUBLIC_* only (Next.js inlines these at build time).

# Required — from Convex dashboard → Deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional — HTTP actions / .convex.site URL
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Prefer supabase when configured (see web/lib/dataBackend.ts).
NEXT_PUBLIC_GIGA3_DATA_BACKEND=supabase

# Required when NEXT_PUBLIC_GIGA3_DATA_BACKEND=supabase.
NEXT_PUBLIC_SUPABASE_URL=https://bgkkrezloideuwfwkloz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required only for server-side migration/admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack public key — enables Inline popup checkout (also readable from Convex PAYSTACK_PUBLIC_KEY)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key

# Public Google Identity Services web client ID. This is not a secret.
# Create an OAuth "Web application" client in Google Cloud, authorized
# JavaScript origin https://www.giga3ai.com (and http://localhost:3000 for dev).
# The same value must be set on Convex as GOOGLE_CLIENT_ID. Do not put a
# Google client secret, RESEND_API_KEY, or SESSION_SIGNING_SECRET here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only Hugging Face token for a future African TTS provider.
# Leave this blank. Never commit a real token and never rename it to NEXT_PUBLIC_HF_TOKEN.
# The static site cannot read it. Set it on the Convex deployment
# (Dashboard → production → Settings → Environment Variables).
# A fine-grained read token is enough. Setting it does not enable MMS synthesis.
HF_TOKEN=

# Server-only Khaya / GhanaNLP subscription key for African TTS, translation, and ASR.
# Sent only as the Ocp-Apim-Subscription-Key header from Convex. Never NEXT_PUBLIC_.
# Leave blank here. Set it on the Convex deployment, separate from HF_TOKEN.
KHAYA_SUBSCRIPTION_KEY=

# --- Giga3 AI blog web push (OneSignal) ---
# Both required to enable the soft opt-in UI on /blog/. Leave unset to keep the feature off.
# App ID is public (dashboard → Settings → Keys & IDs). Never put the REST API Key here.
# NEXT_PUBLIC_GIGA3_BLOG_PUSH_ENABLED=true
# NEXT_PUBLIC_ONESIGNAL_APP_ID=
#
# Server-only OneSignal REST API Key for future publish→notify automation (CI or Convex).
# Never rename to NEXT_PUBLIC_*. Never commit a real key.
# ONESIGNAL_REST_API_KEY=
# See docs/BLOG_ONESIGNAL_PUSH.md

