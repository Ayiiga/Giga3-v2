# Cloudflare Pages — Next.js static export (trailingSlash: true)
#
# Connection stability (prevents ERR_CONNECTION_CLOSED on long-lived requests):
#   Cloudflare Dashboard → Rules → Origin Rules → increase origin response timeout.
#   If proxied via Nginx: proxy_read_timeout 120s; keepalive_timeout 65s;
#
/payment/success/*  /payment/success/index.html  200
/payment/failed/*   /payment/failed/index.html   200
/offline.html         /offline.html                  200
# Per-post/profile/item pages are pre-rendered at build — do not rewrite them to
# noindex legacy shells (that blocked Google from indexing public content).

# Account shortcuts (chat overflow menu + bookmarks)
/privacy            /legal/privacy/              301
/privacy/           /legal/privacy/              301

# Legacy static site paths → App Router
/login.html         /chat/login/                 301
/signup.html        /chat/login/                 301
/dashboard.html     /chat/                       301
/pricing.html       /pricing/                    301
/payment-success.html /payment/success/          301

# Unknown URLs must 404 via web/out/404.html. Do not rewrite them to /index.html.
# Apex → www is handled in functions/_middleware.js. Pages _redirects cannot change hostname.
