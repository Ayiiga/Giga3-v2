# Cloudflare Pages — Next.js static export (trailingSlash: true)
/payment/success/*  /payment/success/index.html  200
/payment/failed/*   /payment/failed/index.html   200
/chat/*               /chat/index.html               200
# Per-post/profile/item pages are pre-rendered at build — do not rewrite them to
# noindex legacy shells (that blocked Google from indexing public content).

# Legacy static site paths → App Router
/login.html         /chat/login/                 301
/signup.html        /chat/login/                 301
/dashboard.html     /chat/                       301
/pricing.html       /pricing/                    301
/payment-success.html /payment/success/          301

# Canonical host: apex → www (Cloudflare Pages honours absolute-URL redirects when both domains are attached)
https://giga3ai.com/*  https://www.giga3ai.com/:splat  301
